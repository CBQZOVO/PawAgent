{
  "name": "paw",
  "private": true,
  "version": "1.0.0-rc.2",
  "packageManager": "pnpm@12.21.0",
  "description": "Paw — 本地工作区 AI Agent 桌面与 Web 应用（基于 @paw/kernel）",
  "scripts": {
    "dev": "pnpm --filter @paw/server dev",
    "dev:web": "pnpm --filter @paw/web dev",
    "build": "pnpm --filter @paw/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "desktop": "pnpm --filter @paw/desktop start",
    "rebuild-app": "bash desktop/scripts/rebuild-restart.sh",
    "package-app": "bash build-app.sh",
    "package-app:win": "pwsh -File build-app.ps1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "typescript": "^5.7.2"
  }
}